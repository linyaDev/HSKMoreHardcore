<?xml version="1.0" encoding="utf-8"?>
<Patch>
	<!-- Крупные партии железной руды у оптовиков и поселения племени
	     (у орбитального оптовика железа в стоке нет).
	     Сток: Core_SK_CoreModule/TraderKindDefs.xml -->

	<!-- Оптовик поселенцев: сток 120-350 -->
	<Operation Class="PatchOperationReplace">
		<xpath>Defs/TraderKindDef[defName="Caravan_Outlander_BulkGoods"]/stockGenerators/li[thingDef="Iron"]/countRange</xpath>
		<value><countRange>800~1600</countRange></value>
	</Operation>

	<!-- Оптовик племени: сток 120-250 -->
	<Operation Class="PatchOperationReplace">
		<xpath>Defs/TraderKindDef[defName="Caravan_Neolithic_BulkGoods"]/stockGenerators/li[thingDef="Iron"]/countRange</xpath>
		<value><countRange>700~1400</countRange></value>
	</Operation>
	<!-- Поселение племени: сток 300-600 -->
	<Operation Class="PatchOperationReplace">
		<xpath>Defs/TraderKindDef[defName="Base_Neolithic_Standard"]/stockGenerators/li[thingDef="Iron"]/countRange</xpath>
		<value><countRange>900~1800</countRange></value>
	</Operation>
</Patch>
