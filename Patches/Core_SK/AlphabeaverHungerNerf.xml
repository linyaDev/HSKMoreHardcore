<?xml version="1.0" encoding="utf-8"?>
<Patch>
	<!-- Альфабобры: голод 3.0 -> 1.0. Жрут лес втрое медленнее, но без деревьев
	     живут дольше (умирают от голода не за день-полтора, а за несколько).
	     Деф расы — свой у Core_SK (Races_Animal_Rodentlike.xml), не ванильный. -->
	<Operation Class="PatchOperationReplace">
		<xpath>Defs/ThingDef[defName="Alphabeaver"]/race/baseHungerRate</xpath>
		<value><baseHungerRate>1.0</baseHungerRate></value>
	</Operation>
</Patch>
