	<Operation Class="PatchOperationReplace">
		<xpath>/Defs/ThingDef[defName="Dryad_Medicinemaker"]/comps/li[@Class="CompProperties_Spawner"]/spawnCount</xpath>
		<value><spawnCount>2</spawnCount></value>
