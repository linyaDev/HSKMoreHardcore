<?xml version="1.0" encoding="utf-8"?>
<Patch>
	<!--
		Ручной ремонтный станок (HandMendingWorkbench, исследование Repair_table_B1)
		чинит по рецепту MendRepairArmor. В паке там только одежда, щиты, ближний бой
		и примитивная дальнобойка (луки, арбалеты, метательное) — любой огнестрел
		требовал электрического станка (TableMending, рецепт MendComplexWeapon,
		навык 14 против 4 здесь).

		Пускаем на него пистолеты целиком (категория Pistols — в Core_SK это первые
		стволы вообще: Gun_Revolver и RF_Gun_VektorCP открываются исследованием
		Gunsmithing) и первый тир остального огнестрела поимённо:

		    Gun_BoltActionRifle (Lee-Enfield)        Rifles_C1
		    Gun_PumpShotgun, Gun_M37A2_USCM          GasOperation
		    Gun_MachinePistol (PDW), RF_Gun_TMP,
		    RF_Gun_Skorpion, RF_Gun_GreaseGun        BlowbackOperation

		Всё, что идёт со второго тира (Rifles_C2, Shotgun_C2, SMG_C2 и выше),
		автоматика и снайперки остаются на электрическом TableMending.

		Правятся оба фильтра: ingredients — что берут в работу, fixedIngredientFilter —
		что видно в самом билле.
	-->
	<Operation Class="PatchOperationSequence">
		<operations>

			<li Class="PatchOperationAdd">
				<xpath>Defs/RecipeDef[defName="MendRepairArmor"]/ingredients/li/filter/categories</xpath>
				<value>
					<li>Pistols</li>
				</value>
			</li>
			<li Class="PatchOperationAdd">
				<xpath>Defs/RecipeDef[defName="MendRepairArmor"]/fixedIngredientFilter/categories</xpath>
				<value>
					<li>Pistols</li>
				</value>
			</li>

			<li Class="PatchOperationAdd">
				<xpath>Defs/RecipeDef[defName="MendRepairArmor"]/ingredients/li/filter</xpath>
				<value>
					<thingDefs>
						<li>Gun_BoltActionRifle</li>
						<li>Gun_PumpShotgun</li>
						<li>Gun_M37A2_USCM</li>
						<li>Gun_MachinePistol</li>
						<li>RF_Gun_TMP</li>
						<li>RF_Gun_Skorpion</li>
						<li>RF_Gun_GreaseGun</li>
					</thingDefs>
				</value>
			</li>
			<li Class="PatchOperationAdd">
				<xpath>Defs/RecipeDef[defName="MendRepairArmor"]/fixedIngredientFilter</xpath>
				<value>
					<thingDefs>
						<li>Gun_BoltActionRifle</li>
						<li>Gun_PumpShotgun</li>
						<li>Gun_M37A2_USCM</li>
						<li>Gun_MachinePistol</li>
						<li>RF_Gun_TMP</li>
						<li>RF_Gun_Skorpion</li>
						<li>RF_Gun_GreaseGun</li>
					</thingDefs>
				</value>
			</li>

		</operations>
	</Operation>
</Patch>
