<?xml version="1.0" encoding="utf-8"?>
<Patch>
	<!-- ShipMechChunk: remove electronic and spacer components, reduce industrial 6->2 -->
	<Operation Class="PatchOperationRemove">
		<xpath>Defs/ThingDef[defName="ShipMechChunk"]/costList/ElectronicComponents</xpath>
	</Operation>
	<Operation Class="PatchOperationRemove">
		<xpath>Defs/ThingDef[defName="ShipMechChunk"]/costList/ComponentSpacer</xpath>
	</Operation>
	<Operation Class="PatchOperationReplace">
		<xpath>Defs/ThingDef[defName="ShipMechChunk"]/costList/ComponentIndustrial</xpath>
		<value><ComponentIndustrial>2</ComponentIndustrial></value>
	</Operation>

	<!-- CrashedShipWreck: 20->4 -->
	<Operation Class="PatchOperationReplace">
		<xpath>Defs/ThingDef[defName="CrashedShipWreck"]/costList/ComponentIndustrial</xpath>
		<value><ComponentIndustrial>4</ComponentIndustrial></value>
	</Operation>

	<!-- ShipWreck: 20->4 -->
	<Operation Class="PatchOperationReplace">
		<xpath>Defs/ThingDef[defName="ShipWreck"]/costList/ComponentIndustrial</xpath>
		<value><ComponentIndustrial>4</ComponentIndustrial></value>
	</Operation>

	<!-- APCWreck: 10->3 -->
	<Operation Class="PatchOperationReplace">
		<xpath>Defs/ThingDef[defName="APCWreck"]/costList/ComponentIndustrial</xpath>
		<value><ComponentIndustrial>3</ComponentIndustrial></value>
	</Operation>

	<!-- ShipChunk: 15->2 industrial, remove spacer -->
	<Operation Class="PatchOperationReplace">
		<xpath>Defs/ThingDef[defName="ShipChunk"]/costList/ComponentIndustrial</xpath>
		<value><ComponentIndustrial>2</ComponentIndustrial></value>
	</Operation>
	<Operation Class="PatchOperationRemove">
		<xpath>Defs/ThingDef[defName="ShipChunk"]/costList/ComponentSpacer</xpath>
	</Operation>
</Patch>
