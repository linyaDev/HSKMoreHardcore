<?xml version="1.0" encoding="utf-8"?>
<Patch>
	<!-- "Technical compartment chunk" (ShipMechChunk): remove electronic and spacer
	     components from its costList so deconstruction no longer yields them.
	     Industrial components are kept. -->
	<Operation Class="PatchOperationRemove">
		<xpath>Defs/ThingDef[defName="ShipMechChunk"]/costList/ElectronicComponents</xpath>
	</Operation>
	<Operation Class="PatchOperationRemove">
		<xpath>Defs/ThingDef[defName="ShipMechChunk"]/costList/ComponentSpacer</xpath>
	</Operation>
</Patch>
