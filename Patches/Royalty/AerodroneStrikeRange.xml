<?xml version="1.0" encoding="utf-8"?>
<Patch>
	<!-- Дальность прицеливания привилегий аэродронного удара: 44.9 -> 100
	     (радиус от пешки-обладателя привилегии).

	     Не применяется при HMC Nobility Expanded: он переопределяет эти же
	     дефы (CallOrbitalStrike, CallOrbitalSalvo) своей системой привилегий. -->
	<Operation Class="PatchOperationFindMod">
		<mods><li>Royalty</li></mods>
		<match Class="PatchOperationFindMod">
		<mods><li>HMC Nobility Expanded</li></mods>
		<nomatch Class="PatchOperationSequence">
			<operations>
				<li Class="PatchOperationReplace">
					<xpath>Defs/RoyalTitlePermitDef[defName="CallOrbitalStrike"]/royalAid/targetingRange</xpath>
					<value><targetingRange>100</targetingRange></value>
				</li>
				<li Class="PatchOperationReplace">
					<xpath>Defs/RoyalTitlePermitDef[defName="CallOrbitalSalvo"]/royalAid/targetingRange</xpath>
					<value><targetingRange>100</targetingRange></value>
				</li>
			</operations>
		</nomatch>
		</match>
	</Operation>
</Patch>
