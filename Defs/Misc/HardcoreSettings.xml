<?xml version="1.0" encoding="utf-8"?>
<Defs>
	<HSKMoreHardcore.HardcoreSettingsDef>
		<defName>HSK_HardcoreSettings</defName>
		<label>HSK Hardcore Settings</label>

		<!-- Множитель стоимости крафта патронов (ингредиенты) -->
		<ammoCraftCostMultiplier>5</ammoCraftCostMultiplier>
		<!-- Множитель стоимости крафта стрел (MakeAmmo_Arrow_*) -->
		<arrowCraftCostMultiplier>1</arrowCraftCostMultiplier>
		<!-- Множитель стоимости крафта болтов (MakeAmmo_Bolt_*) -->
		<boltCraftCostMultiplier>2</boltCraftCostMultiplier>
		<!-- Материалы-исключения: их количество в рецептах патронов не множится -->
		<ammoCraftExcludedMaterials>
			<li>ElectronicComponents</li>
			<!-- Оружейные детали добавлены патчем AmmoWeaponParts.xml, расход там задан
			     по классу калибра и множиться не должен -->
			<li>Pistol_Component</li>
			<li>SMG_Component</li>
			<li>Shotgun_Component</li>
			<li>Rifle_Component</li>
			<li>Sniper_Component</li>
			<li>Heavy_Component</li>
		</ammoCraftExcludedMaterials>
		<!-- Рецепты патронов, исключённые из множителя стоимости -->
		<ammoCraftExcludedRecipes>
			<li>MakeAmmo_StoneBall</li>
			<li>MakeAmmo_ExplosiveBall</li>
			<!-- Пилумы — неолитный расходник, как стрелы (в CE 60% возврат после броска) -->
			<li>MakeAmmo_Pilum</li>
			<!-- Дротики духовой трубки — как стрелы, без множителя -->
			<li>MakeAmmo_Dart</li>
			<li>MakeAmmo_Dart_Stone</li>
			<li>MakeAmmo_Dart_Metal</li>
		</ammoCraftExcludedRecipes>
		<!-- Множитель размера глубинных залежей (1/7 = ~0.143) -->
		<deepResourceMultiplier>0.143</deepResourceMultiplier>
		<!-- Минимум серебра у торговцев (0 = отключено, серебро как сгенерировалось) -->
		<traderSilverMinimum>0</traderSilverMinimum>
		<!-- Шанс отрастания дерева (0.03 = вырастет 3% деревьев; 1.0 — ваниль).
		     Начальную генерацию карты не затрагивает — только отрастание по ходу игры. -->
		<treeRegrowthChance>0.03</treeRegrowthChance>
		<!-- Множители цены продажи торговцу (defName -> множитель) -->
		<sellPriceOverrides>
			<li><key>WoodLog</key><value>0.01</value></li>
		</sellPriceOverrides>
	</HSKMoreHardcore.HardcoreSettingsDef>
</Defs>
