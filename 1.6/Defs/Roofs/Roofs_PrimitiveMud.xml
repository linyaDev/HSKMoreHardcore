<?xml version="1.0" encoding="utf-8"?>
<Defs>

	<!-- Примитивная крыша из грязи: уродливая (красота -4), зато не горит
	     вовсе (Flammability 0). Стоит 2 кучи грязи (Dirt), доступна со старта.
	     Изоляция между соломой (0.7) и шинглом (0.9). Текстура — WornRockThin из бандла
	     Stratum, заранее перекрашенная в грязь (Textures/HMH/Roofs/MudRoof). -->

	<ThingDef ParentName="SolarWeb_Stratum_RoofBuildableBase">
		<defName>HMH_RoofMud_Buildable</defName>
		<label>primitive mud roof</label>
		<description>A crude roof of packed mud and clay smeared over a lattice. Hideous and heavy, but it will never burn.</description>
		<statBases>
			<MaxHitPoints>50</MaxHitPoints>
			<WorkToBuild>80</WorkToBuild>
			<Beauty>-4.0</Beauty>
			<Flammability>0</Flammability>
			<SolarWeb-Stratum-Insulation>0.8</SolarWeb-Stratum-Insulation>
			<SolarWeb-Stratum-ThermalConductivity>0.2</SolarWeb-Stratum-ThermalConductivity>
		</statBases>
		<costList>
			<Dirt>2</Dirt>
		</costList>
		<uiOrder>2003</uiOrder>
		<constructionSkillPrerequisite>0</constructionSkillPrerequisite>
	</ThingDef>

	<SolarWeb.Stratum.Defs.StratumRoofDef>
		<defName>HMH_RoofMud</defName>
		<label>primitive mud roof</label>
		<description>A crude roof of packed mud and clay smeared over a lattice. Hideous and heavy, but it will never burn.</description>
		<isThickRoof>false</isThickRoof>
		<filthLeaving>Filth_Dirt</filthLeaving>
		<soundPunchThrough>Pawn_Melee_Punch_HitBuilding_Wood</soundPunchThrough>
		<modExtensions>
			<li Class="SolarWeb.Stratum.DefModExtensions.BuildableRoofExtension">
				<buildableDef>HMH_RoofMud_Buildable</buildableDef>
				<!-- Своя заранее затонированная текстура: генератор иконок Stratum
				     игнорирует цветовой тинт материала, тинтованный атлас давал
				     белую иконку в дизайнере -->
				<graphicData>
					<texPath>HMH/Roofs/MudRoof</texPath>
					<isSeamless>true</isSeamless>
				</graphicData>
				<designationCategory>Structure</designationCategory>
			</li>
			<li Class="SolarWeb.Kalyphos.DefModExtensions.StructuralProperties" MayRequire="SolarWeb.Kalyphos">
				<Name>Primitive Mud Roof</Name>
				<Properties>
					<ThermalCapacity>800</ThermalCapacity>
					<ThermalConductivity>0.2</ThermalConductivity>
					<FaceGasPermeability>0</FaceGasPermeability>
					<MaxPressureDeltaKpa>50</MaxPressureDeltaKpa>
				</Properties>
			</li>
		</modExtensions>
	</SolarWeb.Stratum.Defs.StratumRoofDef>

</Defs>
