<?xml version="1.0" encoding="utf-8"?>
<Defs>

	<!-- Примитивная черепичная крыша (дранка) — копия shingle roof из Stratum,
	     но только из дерева/досок (Woody), доступна со старта (навык 0, без
	     исследований) и с красотой 0. Остальные статы — как у оригинала.
	     Пара дефов по схеме Stratum: Buildable (ThingDef-заготовка) +
	     StratumRoofDef (сама крыша) со связкой через BuildableRoofExtension. -->

	<ThingDef ParentName="SolarWeb_Stratum_RoofBuildableBase">
		<defName>HMH_RoofShingleWood_Buildable</defName>
		<label>wooden shake roof</label>
		<description>Crude wooden shakes split from planks. Cheaper-looking than proper shingles, but anyone can nail them up, and they still keep the weather out.</description>
		<statBases>
			<MaxHitPoints>80</MaxHitPoints>
			<WorkToBuild>100</WorkToBuild>
			<Beauty>0</Beauty>
			<Flammability>1.0</Flammability>
			<SolarWeb-Stratum-Insulation>0.9</SolarWeb-Stratum-Insulation>
			<SolarWeb-Stratum-ThermalConductivity>0.1</SolarWeb-Stratum-ThermalConductivity>
			<SolarWeb-Stratum-DamageThreshold>3</SolarWeb-Stratum-DamageThreshold>
			<SolarWeb-Stratum-ArmorRating>0.15</SolarWeb-Stratum-ArmorRating>
			<SolarWeb-Stratum-StuffArmorMultiplier>1.0</SolarWeb-Stratum-StuffArmorMultiplier>
		</statBases>
		<stuffCategories>
			<li>Woody</li>
		</stuffCategories>
		<costStuffCount>1</costStuffCount>
		<uiOrder>2019</uiOrder>
		<constructionSkillPrerequisite>0</constructionSkillPrerequisite>
	</ThingDef>

	<SolarWeb.Stratum.Defs.StratumRoofDef>
		<defName>HMH_RoofShingleWood</defName>
		<label>wooden shake roof</label>
		<description>Crude wooden shakes split from planks. Cheaper-looking than proper shingles, but anyone can nail them up, and they still keep the weather out.</description>
		<isThickRoof>false</isThickRoof>
		<filthLeaving>Filth_RubbleBuilding</filthLeaving>
		<soundPunchThrough>Pawn_Melee_Punch_HitBuilding_Wood</soundPunchThrough>
		<modExtensions>
			<li Class="SolarWeb.Stratum.DefModExtensions.BuildableRoofExtension">
				<buildableDef>HMH_RoofShingleWood_Buildable</buildableDef>
				<graphicData>
					<texPath>Roofs/ShingleRoof</texPath>
					<isSeamless>true</isSeamless>
				</graphicData>
				<!-- Под HSK категории Stratum нет — compat-слой кладёт крыши в Structure -->
				<designationCategory>Structure</designationCategory>
			</li>
			<li Class="SolarWeb.Kalyphos.DefModExtensions.StructuralProperties" MayRequire="SolarWeb.Kalyphos">
				<Name>Primitive Shingle Roof</Name>
				<Properties>
					<ThermalCapacity>1200</ThermalCapacity>
					<ThermalConductivity>0.1</ThermalConductivity>
					<FaceGasPermeability>0</FaceGasPermeability>
					<MaxPressureDeltaKpa>200</MaxPressureDeltaKpa>
				</Properties>
			</li>
		</modExtensions>
	</SolarWeb.Stratum.Defs.StratumRoofDef>

</Defs>
