<?xml version="1.0" encoding="utf-8" ?>
<Defs>

	<!-- Лёгкие болты — собственный боеприпас одноручной балестры (Arbalest).
	     Слабее обычных арбалетных болтов (18 урона, 3.7/5.8, скорость 72) —
	     плата за одноручность. Свой класс боеприпаса, чтобы не пересекаться
	     с болтами тяжёлых арбалетов. -->

	<CombatExtended.AmmoCategoryDef>
		<defName>BoltLight</defName>
		<label>light bolt</label>
		<labelShort>light</labelShort>
	</CombatExtended.AmmoCategoryDef>

	<!-- ==================== AmmoSet ========================== -->

	<CombatExtended.AmmoSetDef>
		<defName>AmmoSet_LightBolt</defName>
		<label>light bolts</label>
		<ammoTypes>
			<Ammo_Bolt_Light>Projectile_LightBolt</Ammo_Bolt_Light>
		</ammoTypes>
	</CombatExtended.AmmoSetDef>

	<!-- ==================== Ammo ========================== -->

	<ThingDef Class="CombatExtended.AmmoDef" ParentName="AmmoBoltBase">
		<defName>Ammo_Bolt_Light</defName>
		<label>light bolt</label>
		<description>A short, light crossbow bolt for one-handed arbalests. Weaker than a full-sized bolt.</description>
		<graphicData>
			<texPath>Things/Ammo/Neolithic/Bolt/Steel</texPath>
			<graphicClass>Graphic_StackCount</graphicClass>
		</graphicData>
		<statBases>
			<MarketValue>0.15</MarketValue>
			<Mass>0.07</Mass>
			<Bulk>0.05</Bulk>
		</statBases>
		<ammoClass>BoltLight</ammoClass>
	</ThingDef>

	<!-- ================== Projectiles ================== -->

	<ThingDef Class="CombatExtended.AmmoDef" ParentName="BaseBoltProjectile">
		<defName>Projectile_LightBolt</defName>
		<label>light bolt</label>
		<graphicData>
			<texPath>Things/Projectile/Arrows/Arrow_Steel</texPath>
			<graphicClass>Graphic_Single</graphicClass>
			<drawSize>0.55</drawSize>
		</graphicData>
		<projectile Class="CombatExtended.ProjectilePropertiesCE">
			<damageAmountBase>12</damageAmountBase>
			<speed>62</speed>
			<armorPenetrationSharp>2.6</armorPenetrationSharp>
			<armorPenetrationBlunt>4.0</armorPenetrationBlunt>
			<preExplosionSpawnChance>0.6</preExplosionSpawnChance>
			<preExplosionSpawnThingDef>Ammo_Bolt_Light</preExplosionSpawnThingDef>
		</projectile>
	</ThingDef>

	<!-- ==================== Recipes ========================== -->

	<RecipeDef ParentName="AmmoRecipeNeolithicBase">
		<defName>MakeAmmo_Bolt_Light</defName>
		<label>make light bolts x50</label>
		<description>Craft 50 light bolts.</description>
		<jobString>Making light bolts.</jobString>
		<workAmount>400</workAmount>
		<ingredients>
			<li>
				<filter>
					<categories>
						<li>Wooden</li>
					</categories>
				</filter>
				<count>5</count>
			</li>
			<li>
				<filter>
					<categories>
						<li>Metallic</li>
					</categories>
				</filter>
				<count>6</count>
			</li>
		</ingredients>
		<fixedIngredientFilter>
			<categories>
				<li>Wooden</li>
				<li>Metallic</li>
			</categories>
		</fixedIngredientFilter>
		<products>
			<Ammo_Bolt_Light>50</Ammo_Bolt_Light>
		</products>
		<researchPrerequisite>Greatbow</researchPrerequisite>
	</RecipeDef>

</Defs>
