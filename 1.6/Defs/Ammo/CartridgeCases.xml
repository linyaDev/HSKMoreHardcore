	<!-- ==================== Recipes ========================== -->
	<!-- Металл = весь металл рецепта детали Core_SK (Recipes_WeaponComponents.xml),
	     с развёрнутыми вложенными частями по рецептам HSK:
	       компонент  (Make_ComponentIndustrial: 30 стали -> 10)      = 3 стали;
	       механизм   (MakeSimpleMechanism: 30 стали + 10 комп. -> 5) = 12 стали;
	       проволока  (MakeWires: 10 цветного -> 20)                  = 0.5 цветного.
	     Дробные значения округлены вверх.
	       пистолетные:  6+3  + 2 комп. + 1 пров. + 1 мех.  = 24 стали, 4 цветного;
	       дробовые:     15+8 + 4 комп. + 5 пров. + 2 мех.  = 51 сталь, 11 цветного;
	       винтовочные:  20+10 + 6 комп. + 8 пров. + 3 мех. = 74 стали, 14 цветного;
	       полноразмерные: винтовочная деталь + 6 комп. (стекло не металл)
	                                                        = 92 стали, 14 цветного;
	       крупнокалиберные: 25+15 + 12 комп. + 15 пров. + 6 мех.
	                                                        = 133 стали, 23 цветного. -->

	<RecipeDef>
		<defName>MakeCartridgeCase_Pistol</defName>
		<label>make pistol cartridge cases</label>
		<description>Make pistol cartridge cases from metal. Produces 1.</description>
		<jobString>Making pistol cartridge cases.</jobString>
		<workAmount>1200</workAmount>
		<workSpeedStat>SmithingSpeed</workSpeedStat>
		<effectWorking>Smith</effectWorking>
		<soundWorking>Recipe_Machining</soundWorking>
		<skillRequirements>
			<Crafting>4</Crafting>
		</skillRequirements>
		<ingredients>
			<li>
				<filter>
					<categories>
						<li>SLDBar</li>
						<li>USLDBar</li>
					</categories>
				</filter>
				<count>24</count>
			</li>
			<li>
				<filter>
					<categories>
						<li>HCMBar</li>
					</categories>
				</filter>
				<count>4</count>
			</li>
		</ingredients>
		<fixedIngredientFilter>
			<categories>
				<li>SLDBar</li>
				<li>USLDBar</li>
				<li>HCMBar</li>
			</categories>
		</fixedIngredientFilter>
		<products>
			<CartridgeCase_Pistol>1</CartridgeCase_Pistol>
		</products>
		<workSkill>Crafting</workSkill>
		<workSkillLearnFactor>0.8</workSkillLearnFactor>
		<recipeUsers>
			<li>AmmoBench</li>
		</recipeUsers>
		<researchPrerequisite>Gunsmithing</researchPrerequisite>
	</RecipeDef>

