<?xml version="1.0" encoding="utf-8"?>
<Patch>
	<!-- Племенной военный торговец (Caravan_Neolithic_WarMerchant): вернуть
	     добавки CE — FSX, прометеум и скупку патронов. CE добавляет их своим
	     патчем, но CE грузится раньше Core_SK_CoreModule, а тот целиком заменяет
	     stockGenerators — добавки стираются. У прочих оружейных торговцев сток
	     не переписывается, у них всё на месте. Наш мод грузится последним.
	     Генератор Ammo с нулевым количеством ничего не продаёт, но включает
	     скупку патронов у игрока. -->
	<Operation Class="PatchOperationAdd">
		<xpath>Defs/TraderKindDef[defName="Caravan_Neolithic_WarMerchant"]/stockGenerators</xpath>
		<value>
			<li Class="StockGenerator_SingleDef">
				<thingDef>FSX</thingDef>
				<countRange>5~20</countRange>
			</li>
			<li Class="StockGenerator_SingleDef">
				<thingDef>Prometheum</thingDef>
				<countRange>5~20</countRange>
			</li>
			<li Class="StockGenerator_Category">
				<categoryDef>Ammo</categoryDef>
				<thingDefCountRange>0~0</thingDefCountRange>
			</li>
		</value>
	</Operation>
</Patch>
