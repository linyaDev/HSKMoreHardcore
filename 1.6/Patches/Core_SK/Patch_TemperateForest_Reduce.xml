<?xml version="1.0" encoding="utf-8"?>
<Patch>

	<!-- Reduce TemperateForest: plantDensity 0.65 -> 0.525, tree weights x0.65,
	     animals reduced. Non-tree weights left at HSK stock.
	     Итог по абсолютному числу: деревья ~62% от исходного HSK (середина между
	     стоком и прежним нерфом x0.35, дававшим ~25%), трава/кусты ~97%.
	     Dense variant carries the original HSK values -->

	<!-- animalDensity: 3.3 -> 1.61 (-51%) -->
	<Operation Class="PatchOperationReplace">
		<xpath>Defs/BiomeDef[defName="TemperateForest"]/animalDensity</xpath>
		<value><animalDensity>1.61</animalDensity></value>
	</Operation>

	<!-- plantDensity: 0.65 -> 0.525 -->
