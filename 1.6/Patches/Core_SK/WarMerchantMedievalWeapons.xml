<?xml version="1.0" encoding="utf-8"?>
<Patch>
	<!-- Военный караванщик (Caravan_Neolithic_WarMerchant) возит средневековое
	     оружие вместо неолитного: старые неолитные генераторы убираются, вместо
	     них Medieval (нижней границы техуровня в StockGenerator нет, так что
	     неолит формально тоже может попасться, но потолок теперь средневековый).
	     Сток задаётся патчем Core_SK_CoreModule, наш мод грузится позже.
	     Затрагивает все фракции с этим караваном (Княжество, Королевство,
	     Норбалы, Хищники) — все средневековые. -->
	<Operation Class="PatchOperationRemove">
		<xpath>Defs/TraderKindDef[defName="Caravan_Neolithic_WarMerchant"]/stockGenerators/li[@Class="StockGenerator_Category"][categoryDef="WeaponsMelee"][maxTechLevelGenerate="Neolithic"]</xpath>
	</Operation>
	<Operation Class="PatchOperationRemove">
		<xpath>Defs/TraderKindDef[defName="Caravan_Neolithic_WarMerchant"]/stockGenerators/li[@Class="StockGenerator_MarketValue"][tradeTag="WeaponRanged"][maxTechLevelGenerate="Neolithic"]</xpath>
	</Operation>

	<Operation Class="PatchOperationAdd">
		<xpath>Defs/TraderKindDef[defName="Caravan_Neolithic_WarMerchant"]/stockGenerators</xpath>
		<value>
			<li Class="StockGenerator_Category">
				<maxTechLevelGenerate>Medieval</maxTechLevelGenerate>
				<categoryDef>WeaponsMelee</categoryDef>
				<thingDefCountRange>2~3</thingDefCountRange>
				<countRange>1~1</countRange>
				<totalPriceRange>600~1600</totalPriceRange>
			</li>
			<!-- Арбалеты по категории, а не по тегу WeaponRanged: тег тянет весь
			     неолитный пул (луки, пращи, пилумы — у Pila он тоже есть), и
			     средневековое почти не выпадает. Компаундный арбалет отсекается
			     потолком Medieval (он Industrial). -->
			<li Class="StockGenerator_Category">
				<maxTechLevelGenerate>Medieval</maxTechLevelGenerate>
				<categoryDef>CrossbarRanged</categoryDef>
				<thingDefCountRange>1~2</thingDefCountRange>
				<countRange>1~1</countRange>
				<totalPriceRange>300~900</totalPriceRange>
			</li>
		</value>
	</Operation>
</Patch>
