<?xml version="1.0" encoding="utf-8"?>
<Patch>
	<!-- Дешевле по средневековым компонентам: усиленный арбалет (Crossbow)
	     8 -> 2, балестра (Arbalest) 7 -> 2. Дерево не трогаем. -->
	<Operation Class="PatchOperationReplace">
		<xpath>Defs/ThingDef[defName="Crossbow"]/costList/ComponentMedieval</xpath>
		<value><ComponentMedieval>2</ComponentMedieval></value>
	</Operation>
	<Operation Class="PatchOperationReplace">
		<xpath>Defs/ThingDef[defName="Arbalest"]/costList/ComponentMedieval</xpath>
		<value><ComponentMedieval>2</ComponentMedieval></value>
	</Operation>
</Patch>
