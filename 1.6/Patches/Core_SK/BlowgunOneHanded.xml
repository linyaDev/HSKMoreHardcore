<?xml version="1.0" encoding="utf-8"?>
<Patch>
	<!-- Духовая трубка — одноручное оружие (CE-тег, позволяет носить со щитом). -->
	<Operation Class="PatchOperationAdd">
		<xpath>Defs/ThingDef[defName="blowgun"]/weaponTags</xpath>
		<value>
			<li>CE_OneHandedWeapon</li>
		</value>
	</Operation>

	<!-- Рецепт: только 35 дерева. Травяная медицина в costList — рудимент
	     времён «трубки с набором ядовитых дротиков», яд теперь в самих дротиках. -->
	<Operation Class="PatchOperationRemove">
		<xpath>Defs/ThingDef[defName="blowgun"]/costList</xpath>
	</Operation>

	<!-- Новые дротики в аммосет трубки (дефы — в Defs/Ammo/Darts_StoneMetal.xml). -->
	<Operation Class="PatchOperationAdd">
		<xpath>Defs/CombatExtended.AmmoSetDef[defName="AmmoSet_Darts"]/ammoTypes</xpath>
		<value>
			<Ammo_Dart_Stone>StoneDart</Ammo_Dart_Stone>
			<Ammo_Dart_Metal>MetalDart</Ammo_Dart_Metal>
		</value>
	</Operation>
</Patch>
